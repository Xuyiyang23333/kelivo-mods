diff --git a/lib/l10n/app_localizations.dart b/lib/l10n/app_localizations.dart
index fae5af2..01322fd 100644
--- a/lib/l10n/app_localizations.dart
+++ b/lib/l10n/app_localizations.dart
@@ -29321,6 +29321,144 @@ abstract class AppLocalizations {
   /// In en, this message translates to:
   /// **'Custom'**
   String get themePaletteCustom;
+
+  /// Title of the Mods settings page and its entry in the mobile and desktop settings lists; keep the product name Mods untranslated where the app already uses it.
+  ///
+  /// In en, this message translates to:
+  /// **'Mods'**
+  String get modsPageTitle;
+
+  /// Title of the Phone Agent section on the Mods settings page; Phone Agent is the product name of the private phone-control tool set and stays untranslated.
+  ///
+  /// In en, this message translates to:
+  /// **'Phone Agent'**
+  String get phoneAgentTitle;
+
+  /// Subtitle under the Phone Agent section title explaining that the assistant tool choice and the separate accessibility service status are configured here.
+  ///
+  /// In en, this message translates to:
+  /// **'Choose which phone control tool set this assistant can use, and check the separate accessibility service.'**
+  String get phoneAgentSubtitle;
+
+  /// Status line in the Phone Agent service panel while the accessibility service state is being read.
+  ///
+  /// In en, this message translates to:
+  /// **'Checking service status…'**
+  String get phoneAgentStatusChecking;
+
+  /// Status line in the Phone Agent service panel when the separate accessibility service is enabled and connected.
+  ///
+  /// In en, this message translates to:
+  /// **'Enabled and connected'**
+  String get phoneAgentStatusReady;
+
+  /// Status line in the Phone Agent service panel when the separate accessibility service is not enabled in system accessibility settings.
+  ///
+  /// In en, this message translates to:
+  /// **'Not enabled'**
+  String get phoneAgentStatusDisabled;
+
+  /// Status line in the Phone Agent service panel when the accessibility service is enabled but not connected; advises toggling the service in system settings and refreshing.
+  ///
+  /// In en, this message translates to:
+  /// **'Enabled, but not connected. Try turning the service off and on in system settings, then refresh.'**
+  String get phoneAgentStatusDisconnected;
+
+  /// Status line in the Phone Agent service panel when the plugin cannot read the service state; advises refreshing.
+  ///
+  /// In en, this message translates to:
+  /// **'Unable to read service status. Refresh to try again.'**
+  String get phoneAgentStatusUnavailable;
+
+  /// Message shown on the Mods page when Phone Agent is not supported, such as on non-Android platforms; no tools are added in this state.
+  ///
+  /// In en, this message translates to:
+  /// **'Phone Agent is only available on Android.'**
+  String get phoneAgentUnsupportedPlatform;
+
+  /// Button in the Phone Agent service panel that opens the system accessibility settings where the separate service is enabled.
+  ///
+  /// In en, this message translates to:
+  /// **'Open accessibility settings'**
+  String get phoneAgentOpenAccessibilitySettings;
+
+  /// Button in the Phone Agent service panel that re-reads the supported, enabled, connected, and SDK state.
+  ///
+  /// In en, this message translates to:
+  /// **'Refresh status'**
+  String get phoneAgentRefreshStatus;
+
+  /// Hint in the Phone Agent service panel when the Android API level is below 30, noting that screenshots and coordinate actions need Android 11 or later.
+  ///
+  /// In en, this message translates to:
+  /// **'Screenshots and coordinate actions require Android 11 or later.'**
+  String get phoneAgentScreenshotUnavailable;
+
+  /// Section header on the Mods page above the assistant picker.
+  ///
+  /// In en, this message translates to:
+  /// **'Assistant'**
+  String get phoneAgentAssistantSectionTitle;
+
+  /// Label for the assistant picker on the Mods page; the selected assistant's tool choice is edited below it.
+  ///
+  /// In en, this message translates to:
+  /// **'Current assistant'**
+  String get phoneAgentAssistantLabel;
+
+  /// Label for the three mutually exclusive phone control choices on the Mods page: off, native phone control, or Phone Agent.
+  ///
+  /// In en, this message translates to:
+  /// **'Phone control'**
+  String get phoneAgentControlLabel;
+
+  /// Radio option on the Mods page that removes both native phone control and Phone Agent from the assistant without disabling any system service.
+  ///
+  /// In en, this message translates to:
+  /// **'Off'**
+  String get phoneAgentControlOff;
+
+  /// Radio option on the Mods page that keeps native phone control for the assistant, removes Phone Agent, and continues to the upstream phone control authorization page.
+  ///
+  /// In en, this message translates to:
+  /// **'Native phone control'**
+  String get phoneAgentControlNative;
+
+  /// Radio option on the Mods page that enables Phone Agent for the assistant and removes native phone control; it does not authorize the accessibility service.
+  ///
+  /// In en, this message translates to:
+  /// **'Phone Agent'**
+  String get phoneAgentControlMod;
+
+  /// Title of the capabilities and privacy disclosure block in the Phone Agent service panel.
+  ///
+  /// In en, this message translates to:
+  /// **'Capabilities and privacy'**
+  String get phoneAgentDisclosureTitle;
+
+  /// Disclosure text in the Phone Agent service panel covering the separate accessibility service, mutual exclusion with native phone control per assistant, screen content in model tool results, hidden password fields, no continuous recording, the test-package input allowlist in this private build, and no automatic authorization.
+  ///
+  /// In en, this message translates to:
+  /// **'Phone Agent uses a separate accessibility service, and each assistant can use either native phone control or Phone Agent, never both. While enabled, it can read the current screen, tap, enter text, scroll, take screenshots, and navigate. Screen content is sent to the model provider configured for the current conversation and is saved in its tool results. Password fields are hidden. This service does not continuously record screen content. This private build only allows input in the test package, and selecting Phone Agent does not authorize the service or change system accessibility settings.'**
+  String get phoneAgentDisclosure;
+
+  /// Message shown when the Mods page cannot open the system accessibility settings, advising the user to open Android Settings → Accessibility manually.
+  ///
+  /// In en, this message translates to:
+  /// **'Unable to open accessibility settings. Open Android Settings → Accessibility manually.'**
+  String get phoneAgentSettingsUnavailable;
+
+  /// Empty state on the Mods page when no assistants exist, asking the user to create one before choosing a phone control option.
+  ///
+  /// In en, this message translates to:
+  /// **'No assistants yet. Create an assistant first.'**
+  String get phoneAgentNoAssistants;
+
+  /// Message shown near the three-state phone control selection on the Mods page when the assistant has both native phone control and Phone Agent enabled, prompting the user to choose one option again.
+  ///
+  /// In en, this message translates to:
+  /// **'This assistant has both phone control implementations enabled. Choose one to resolve the conflict.'**
+  String get phoneAgentConflict;
 }
 
 class _AppLocalizationsDelegate
