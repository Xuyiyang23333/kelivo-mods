+  /// 「允许并继续」的续跑入口：注册到 Phone Agent 的批准服务。
+  ///
+  /// 只发送一条“已批准，请重新观察再继续”的用户消息，**不重放**被拒绝时的
+  /// 点击/输入/手势：批准发生在过去，旧句柄、截图与布局都不能假设仍然有效。
+  /// 会话已不是当前会话时只保存授权，不切换会话、不改写对话内容。
+  Future<void> _resumePhoneAgentTask(
+    String conversationId,
+    String packageName,
+  ) async {
+    final l10n = AppLocalizations.of(context);
+    if (!mounted || _controller.currentConversation?.id != conversationId) {
+      if (l10n != null) {
+        showAppSnackBar(
+          context,
+          message: l10n.phoneAgentApprovalResumeUnavailable,
+        );
+      }
+      return;
+    }
+    final message = (l10n?.phoneAgentApprovalResumeMessage(packageName) ?? '')
+        .trim();
+    if (message.isEmpty) return;
+    final result = await _controller.sendMessage(ChatInputData(text: message));
+    if (!mounted || result == ChatInputSubmissionResult.sent) return;
+    if (l10n != null) {
+      showAppSnackBar(
+        context,
+        message: l10n.phoneAgentApprovalResumeUnavailable,
+        type: NotificationType.warning,
+      );
+    }
+  }
+
   @override
   void initState() {
     super.initState();
