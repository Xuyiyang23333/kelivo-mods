diff --git a/lib/l10n/app_localizations.dart b/lib/l10n/app_localizations.dart
index 01322fd..587e9a1 100644
--- a/lib/l10n/app_localizations.dart
+++ b/lib/l10n/app_localizations.dart
@@ -29459,6 +29459,204 @@ abstract class AppLocalizations {
   /// In en, this message translates to:
   /// **'This assistant has both phone control implementations enabled. Choose one to resolve the conflict.'**
   String get phoneAgentConflict;
+
+  /// Title of the in-chat approval card shown when the assistant needs approval for an unnamed app before it can read the screen or send input.
+  ///
+  /// In en, this message translates to:
+  /// **'Allow this app?'**
+  String get phoneAgentApprovalCardTitle;
+
+  /// Title of the in-chat approval card when the app has a display name; {name} is that app label.
+  ///
+  /// In en, this message translates to:
+  /// **'Allow \"{name}\"?'**
+  String phoneAgentApprovalCardTitleNamed(String name);
+
+  /// Explanatory body of the in-chat app approval card stating that approval covers reading the screen plus taps, text and gestures, and that it lasts until revoked.
+  ///
+  /// In en, this message translates to:
+  /// **'Approving lets the assistant read this app\'s screen and send taps, text and gestures. It stays valid until you revoke it in Mods.'**
+  String get phoneAgentApprovalCardBody;
+
+  /// Line on the approval card showing the app's signing certificate SHA-256 prefix used to identify the exact app; {prefix} is 8 hexadecimal characters.
+  ///
+  /// In en, this message translates to:
+  /// **'Signing certificate {prefix}'**
+  String phoneAgentApprovalSigning(String prefix);
+
+  /// Line on the approval card shown when the app's signing certificate could not be read, so the app cannot be approved right now.
+  ///
+  /// In en, this message translates to:
+  /// **'Signing certificate unavailable'**
+  String get phoneAgentApprovalSigningUnavailable;
+
+  /// Primary button on the app approval card that grants approval without resuming the interrupted task.
+  ///
+  /// In en, this message translates to:
+  /// **'Allow'**
+  String get phoneAgentApprovalAllow;
+
+  /// Button on the app approval card that grants approval and asks the assistant to continue the interrupted task after re-reading the screen.
+  ///
+  /// In en, this message translates to:
+  /// **'Allow and continue'**
+  String get phoneAgentApprovalAllowAndContinue;
+
+  /// Button on the app approval card that refuses approval; nothing is read or executed.
+  ///
+  /// In en, this message translates to:
+  /// **'Deny'**
+  String get phoneAgentApprovalDeny;
+
+  /// Confirmation shown after the user approves an app without continuing, reminding that the assistant re-reads the screen before acting.
+  ///
+  /// In en, this message translates to:
+  /// **'Approved. The assistant will re-read the screen before continuing.'**
+  String get phoneAgentApprovalApproved;
+
+  /// Confirmation shown after the user denies app approval, stating that nothing was read or executed.
+  ///
+  /// In en, this message translates to:
+  /// **'Denied. Nothing was read or executed.'**
+  String get phoneAgentApprovalDenied;
+
+  /// Confirmation shown after approval when the interrupted task is being resumed.
+  ///
+  /// In en, this message translates to:
+  /// **'Approved and continuing.'**
+  String get phoneAgentApprovalResumed;
+
+  /// Confirmation shown after approval when there is no task to resume, telling the user to ask the assistant to continue and that it will re-read the screen first.
+  ///
+  /// In en, this message translates to:
+  /// **'Approved. The task stopped when approval was needed, so ask the assistant to continue; it will re-read the screen first.'**
+  String get phoneAgentApprovalResumeUnavailable;
+
+  /// Error shown when saving an app approval failed, for example because the app was uninstalled or is updating; advice to retry.
+  ///
+  /// In en, this message translates to:
+  /// **'Could not save the approval. Check that the app is still installed and not updating, then try again.'**
+  String get phoneAgentApprovalFailed;
+
+  /// Title of the settings page that lists apps the assistant is allowed to read and control, and its entry row on the Mods page.
+  ///
+  /// In en, this message translates to:
+  /// **'Approved apps'**
+  String get phoneAgentApprovedAppsTitle;
+
+  /// Subtitle of the approved apps row on the Mods page, inviting the user to review and revoke app approvals.
+  ///
+  /// In en, this message translates to:
+  /// **'Review and revoke the apps the assistant may read and control.'**
+  String get phoneAgentApprovedAppsRowSubtitle;
+
+  /// Introductory note on the approved apps page explaining that approval covers reading and input, and that revoking only affects the next request because already sent actions are not undone and an already read screen may still be paged briefly.
+  ///
+  /// In en, this message translates to:
+  /// **'Approval covers reading the screen and sending taps, text and gestures. Revoking applies to the next request: anything already sent is not undone, and a screen already read may still be paged for a short time.'**
+  String get phoneAgentApprovedAppsHint;
+
+  /// Empty-state title on the approved apps page when no app has been approved yet.
+  ///
+  /// In en, this message translates to:
+  /// **'No approved apps'**
+  String get phoneAgentApprovedAppsEmpty;
+
+  /// Empty-state body on the approved apps page explaining that approval is requested the first time the assistant needs an app.
+  ///
+  /// In en, this message translates to:
+  /// **'The assistant asks for approval the first time it needs to read or control an app.'**
+  String get phoneAgentApprovedAppsEmptyBody;
+
+  /// Error title on the approved apps page when the stored approvals could not be read.
+  ///
+  /// In en, this message translates to:
+  /// **'Unable to read approved apps'**
+  String get phoneAgentApprovedAppsUnavailable;
+
+  /// Error body on the approved apps page advising a refresh and noting that the list is device-local.
+  ///
+  /// In en, this message translates to:
+  /// **'Refresh to try again. The list is stored on this device only.'**
+  String get phoneAgentApprovedAppsUnavailableBody;
+
+  /// Line under an approved app showing the signing certificate SHA-256 prefix that identifies it; {prefix} is 8 hexadecimal characters.
+  ///
+  /// In en, this message translates to:
+  /// **'Signing certificate {prefix}'**
+  String phoneAgentApprovedAppSigning(String prefix);
+
+  /// Line under an approved app showing when it was first approved; {time} is a formatted local date and time.
+  ///
+  /// In en, this message translates to:
+  /// **'Approved {time}'**
+  String phoneAgentApprovedAppApprovedAt(String time);
+
+  /// Line under an approved app showing when it was approved again most recently; {time} is a formatted local date and time. Ordinary approval reuse is not tracked.
+  ///
+  /// In en, this message translates to:
+  /// **'Last approved {time}'**
+  String phoneAgentApprovedAppLastUsedAt(String time);
+
+  /// Placeholder shown instead of a timestamp when an approved app has no recorded time.
+  ///
+  /// In en, this message translates to:
+  /// **'never'**
+  String get phoneAgentApprovedAppNever;
+
+  /// Group heading on the approved apps page for approvals whose originating assistant is unknown, for example after the assistant was deleted.
+  ///
+  /// In en, this message translates to:
+  /// **'Unknown assistant'**
+  String get phoneAgentApprovedAppUnknownSource;
+
+  /// Button on an approved app row that revokes approval for that app.
+  ///
+  /// In en, this message translates to:
+  /// **'Revoke'**
+  String get phoneAgentApprovedAppRevoke;
+
+  /// Snackbar confirming that approval was revoked for an app; {package} is the package name.
+  ///
+  /// In en, this message translates to:
+  /// **'Revoked {package}.'**
+  String phoneAgentApprovedAppRevoked(String package);
+
+  /// Snackbar shown when revoking an app approval failed, advising a retry.
+  ///
+  /// In en, this message translates to:
+  /// **'Could not revoke the app. Try again.'**
+  String get phoneAgentApprovedAppRevokeFailed;
+
+  /// Title of the one-time dialog shown the first time the user enables Phone Agent, before a short privacy notice.
+  ///
+  /// In en, this message translates to:
+  /// **'Before you enable Phone Agent'**
+  String get phoneAgentPrivacyNoticeTitle;
+
+  /// One-time privacy notice shown on first enabling Phone Agent: screenshots and screen text are sent to the configured model provider, it appears only once, it is information rather than a technical control, and password masking and secure-window blacking are limits rather than guarantees.
+  ///
+  /// In en, this message translates to:
+  /// **'Screenshots and on-screen text are sent as tool results to the model provider you configured for the conversation. That can include chats, message lists and other visible content.\n\nThis notice appears once. It is information, not a technical control: it does not change which apps need approval, and it does not mean screen content stays on this device. Password fields are masked and secure windows may appear black, but these are limits, not guarantees.'**
+  String get phoneAgentPrivacyNoticeBody;
+
+  /// Button on the one-time privacy notice that acknowledges the notice and continues.
+  ///
+  /// In en, this message translates to:
+  /// **'I understand'**
+  String get phoneAgentPrivacyNoticeConfirm;
+
+  /// Button on the one-time privacy notice that closes it without enabling Phone Agent; the notice appears again next time.
+  ///
+  /// In en, this message translates to:
+  /// **'Cancel'**
+  String get phoneAgentPrivacyNoticeCancel;
+
+  /// User-style message sent to the model after the user taps Allow and continue on an app approval card; {package} is the approved package name. It asks the model to re-read the screen and continue without replaying the blocked action.
+  ///
+  /// In en, this message translates to:
+  /// **'I approved {package}. Read the current screen again and continue the task from the real UI state. Do not replay the action that was blocked before approval.'**
+  String phoneAgentApprovalResumeMessage(String package);
 }
 
